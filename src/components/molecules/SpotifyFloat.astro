<aside
	data-spotify-float
	hidden
	transition:persist="spotify-float"
	class="fixed right-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] left-3 z-40 mx-auto max-w-2xl rounded-xl border bg-(--app-surface) p-3 shadow-xl sm:right-6 sm:left-auto sm:w-96"
	aria-label="Latest song played on Spotify"
>
	<a
		data-spotify-link
		class="group flex min-w-0 items-center gap-3 rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-(--app-text) focus-visible:ring-offset-2 focus-visible:ring-offset-(--app-surface)"
		target="_blank"
		rel="noopener noreferrer"
	>
		<img
			data-spotify-cover
			class="size-14 shrink-0 rounded-md object-cover"
			width="56"
			height="56"
			alt=""
		/>
		<span class="min-w-0 flex-1">
			<span class="mb-0.5 block text-xs text-muted">Latest Spotify play</span>
			<strong data-spotify-song class="block truncate text-sm"></strong>
			<span data-spotify-artists class="block truncate text-sm text-muted"></span>
		</span>
		<span
			class="shrink-0 border-b border-(--app-link-border) text-xs font-semibold group-hover:border-transparent"
		>
			Listen
		</span>
	</a>
</aside>

<script>
	import type { LatestTrack as TrackResponse } from "../../lib/spotify";

	function isTrackResponse(value: unknown): value is TrackResponse {
		if (!value || typeof value !== "object") return false;

		const track = value as Record<string, unknown>;
		return (
			typeof track.name === "string" &&
			track.name.length > 0 &&
			Array.isArray(track.artists) &&
			track.artists.length > 0 &&
			track.artists.every(
				(artist) => typeof artist === "string" && artist.length > 0,
			) &&
			typeof track.coverUrl === "string" &&
			track.coverUrl.startsWith("https://") &&
			typeof track.spotifyUrl === "string" &&
			track.spotifyUrl.startsWith("https://open.spotify.com/") &&
			typeof track.playedAt === "string"
		);
	}

	async function initializeSpotifyFloat() {
		const float = document.querySelector<HTMLElement>("[data-spotify-float]");
		if (!float || float.dataset.state === "loading") return;
		if (float.dataset.state === "loaded") {
			document.body.classList.add("spotify-float-visible");
			return;
		}

		float.dataset.state = "loading";

		try {
			const response = await fetch("/api/spotify/recent.json", {
				headers: { Accept: "application/json" },
			});
			if (!response.ok || response.status === 204) return;

			const track: unknown = await response.json();
			if (!isTrackResponse(track)) return;

			const link = float.querySelector<HTMLAnchorElement>("[data-spotify-link]");
			const cover = float.querySelector<HTMLImageElement>("[data-spotify-cover]");
			const song = float.querySelector<HTMLElement>("[data-spotify-song]");
			const artists = float.querySelector<HTMLElement>("[data-spotify-artists]");
			if (!link || !cover || !song || !artists) return;

			const artistNames = track.artists.join(", ");
			link.href = track.spotifyUrl;
			link.setAttribute("aria-label", `Listen to ${track.name} by ${artistNames} on Spotify`);
			cover.src = track.coverUrl;
			cover.alt = `Album artwork for ${track.name}`;
			song.textContent = track.name;
			artists.textContent = artistNames;
			float.hidden = false;
			float.dataset.state = "loaded";
			document.body.classList.add("spotify-float-visible");
		} catch {
			float.hidden = true;
			document.body.classList.remove("spotify-float-visible");
		} finally {
			if (float.dataset.state !== "loaded") {
				delete float.dataset.state;
			}
		}
	}

	document.addEventListener("astro:page-load", initializeSpotifyFloat);
</script>

<style is:global>
	body.spotify-float-visible {
		padding-bottom: 6rem;
	}
</style>
