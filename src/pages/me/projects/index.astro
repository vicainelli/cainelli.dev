---
import { getCollection } from "astro:content";
import ContentWrapper from "@/components/ContentWrapper.astro";
import Breadcrumbs from "@/components/molecules/Breadcrumbs.astro";
import PostList from "@/components/PostList.astro";
import Layout from "@/layouts/Layout.astro";
import { filterAndSortProjects } from "@/lib/projects";

const allProjects = await getCollection("projects");
// biome-ignore lint/correctness/noUnusedVariables: used in template
const nonDraftProjects = filterAndSortProjects(allProjects);

// biome-ignore lint/correctness/noUnusedVariables: used in template
const BREADCRUMBS = [
	{ title: "Home", url: "/" },
	{ title: "Me", url: "/me" },
	{ title: "Projects" },
];
---
<Layout
	title="Projects - Vinicius Cainelli - Staff Product Engineer"
	description="Side projects I am building, shipping, and learning from."
>
	<ContentWrapper>
		<main class="my-20">
			<Breadcrumbs items={BREADCRUMBS} />

			<h1>Projects</h1>
			<PostList
				posts={nonDraftProjects}
				basePath="/me/projects"
				emptyMessage="No projects found yet."
			/>
		</main>
	</ContentWrapper>
</Layout>
